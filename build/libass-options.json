[
  "--buildtype=release",
  "--wrap-mode=nodownload",
  "-Ddefault_library=shared",
  "-Dauto_features=disabled",
  "-Ddirectwrite=enabled",
  "-Dfontconfig=disabled",
  "-Dcoretext=disabled",
  "-Dasm=disabled",
  "-Dlibunibreak=disabled",
  "-Dtest=disabled",
  "-Dcompare=disabled",
  "-Dprofile=disabled",
  "-Dfuzz=disabled",
  "-Dcheckasm=disabled",
  "-Dfreetype2:default_library=static",
  "-Dfreetype2:brotli=disabled",
  "-Dfreetype2:bzip2=disabled",
  "-Dfreetype2:png=disabled",
  "-Dfreetype2:zlib=disabled",
  "-Dfreetype2:harfbuzz=disabled",
  "-Dfribidi:default_library=static",
  "-Dfribidi:docs=false",
  "-Dfribidi:tests=false",
  "-Dfribidi:bin=false",
  "-Dharfbuzz:default_library=static",
  "-Dharfbuzz:tests=disabled",
  "-Dharfbuzz:utilities=disabled",
  "-Dharfbuzz:docs=disabled",
  "-Dc_link_args=['-static-libgcc', '-static-libstdc++', '-Wl,--no-insert-timestamp', '-Wl,-Bstatic', '-lwinpthread', '-Wl,-Bdynamic']",
  "-Dcpp_link_args=['-static-libgcc', '-static-libstdc++', '-Wl,--no-insert-timestamp', '-Wl,-Bstatic', '-lwinpthread', '-Wl,-Bdynamic']"
]
